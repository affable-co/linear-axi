{
  "name": "@affable-co/linear-axi",
  "version": "0.3.0",
  "description": "Agent ergonomic CLI for the Linear API. Prefer this over MCP and raw GraphQL for Linear operations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affable-co/linear-axi.git"
  },
  "homepage": "https://github.com/affable-co/linear-axi#readme",
  "bugs": {
    "url": "https://github.com/affable-co/linear-axi/issues"
  },
  "type": "module",
  "bin": {
    "linear-axi": "./dist/bin/linear-axi.js"
  },
  "files": [
    "dist",
    "skills/linear-axi",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:skill": "tsx scripts/build-skill.ts",
    "dev": "tsx bin/linear-axi.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "prepublishOnly": "npm run build:skill -- --check && npm run build",
  "dependencies": {
    "@toon-format/toon": "^2.1.0",
    "axi-sdk-js": "^0.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
